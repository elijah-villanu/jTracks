# --- Database (owned by DATABASE_TASKS) ---
# app/db/session.py reads DATABASE_URL directly from the OS environment, so it
# must be exported before the app imports (compose/Docker pass it as a real env
# var). Production = PostgreSQL; for local dev with no Postgres, use SQLite:
#   DATABASE_URL=sqlite:///./jtracks_dev.db
# Azure Database for PostgreSQL: append ?sslmode=require (or verify-full with
# the Azure root CA) so the connection can never fall back to plaintext.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/jtracks

# ===================================================================
# Backend app config (BACKEND_TASKS.md). All have safe dev defaults in
# app/core/config.py; override here for real deployments.
# ===================================================================

APP_NAME=jTracks API
# Set to production on any internet-facing host. The app refuses to start on Azure App
# Service while this is a development value (it would serve /docs, drop HSTS
# and sign tokens with a throwaway key).
ENVIRONMENT=development
DEBUG=true

# Dev-only convenience: create tables from model metadata on startup.
# Defaults to FALSE in code, so forgetting this variable is the safe outcome.
# Alembic (DATABASE_TASKS D1) owns the schema everywhere; set true locally only
# if you want create_all() instead of running migrations.
AUTO_CREATE_TABLES=false

# CORS: comma-separated frontend origins (Vite dev server defaults shown).
# '*' is rejected at startup — this is an authenticated API. Each entry must be
# a bare origin (no path, no trailing slash) and, outside development, https:
#   CORS_ORIGINS=https://<frontend-app>.azurewebsites.net
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth / JWT ---
# REQUIRED whenever ENVIRONMENT is not development/dev/local/test — the app
# refuses to start without a strong value (>=32 chars, not a placeholder).
# Leave it blank in development and an ephemeral secret is generated per
# process (tokens then reset on every restart).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# The access token cannot be revoked, so keep it short (bounded 1-60 at
# startup). The old V1 value here, 10080 (7 days), is now rejected.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token (httpOnly cookie) lifetime; bounded 1-30. Absolute: rotation
# does not extend it.
REFRESH_TOKEN_EXPIRE_DAYS=14
# Seconds a just-rotated refresh token is still honoured (so two tabs refreshing
# together aren't flagged as token theft); bounded 0-120, 0 disables.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# The refresh cookie's Secure/SameSite/Path attributes are fixed by
# docs/decisions/cookie-topology-samesite.md and validated at startup —
# REFRESH_COOKIE_SECURE=false is rejected.
# Bound into every token as `iss`/`aud` and required at verification time, so a
# token minted elsewhere with the same secret won't be accepted here.
JWT_ISSUER=jtracks
JWT_AUDIENCE=jtracks-api

# --- Rate limiting (per client IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_SIGNUP=3/hour
RATE_LIMIT_OAUTH=10/minute
RATE_LIMIT_AUTOFILL=10/minute
# Enable whenever the API is behind a reverse proxy — REQUIRED on Azure App
# Service, or every visitor shares the front end's IP and one bucket (anyone can
# lock the owner out of login). Leave false only when clients connect directly.
TRUST_PROXY_HEADERS=false
# Number of proxies that APPEND to X-Forwarded-For; the client IP is read that
# many entries from the right (the only unforgeable position).
# App Service alone = 1. App Service behind Front Door/App Gateway = 2.
TRUSTED_PROXY_HOPS=1

# --- Google OAuth: the OAuth 2.0 Web client ID ID tokens are verified against ---
GOOGLE_CLIENT_ID=

# --- Ghosting scheduler (docs/decisions/scheduler-mechanism.md) ---
# Set true on exactly ONE instance if horizontally scaled (job is idempotent).
RUN_SCHEDULER=true
GHOSTING_JOB_HOUR=3
GHOSTING_JOB_MINUTE=0
DEFAULT_GHOST_DAYS=14

# --- Request limits ---
# Largest accepted request body; anything bigger gets a 413 before it is read.
MAX_REQUEST_BODY_BYTES=1048576

# --- Autofill ---
AUTOFILL_TIMEOUT_SECONDS=8.0
# Largest outbound autofill response buffered. A timeout bounds seconds, not
# bytes — this bounds bytes.
AUTOFILL_MAX_RESPONSE_BYTES=2097152
