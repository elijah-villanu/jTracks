# Base URL of the jTracks backend API.
# Used by src/lib/api-client.ts via import.meta.env.VITE_API_URL.
# Baked in at BUILD time. A production build fails without it, or with a
# non-https, non-localhost value. For Azure, build with e.g.
#   VITE_API_URL=https://<api-app>.azurewebsites.net
VITE_API_URL=http://localhost:8000

# Set to "false" to disable the MSW mock API layer in dev (e.g. once a real
# backend is running locally). Mocks never run in a production build,
# whatever this says.
VITE_ENABLE_MOCKS=true
