# Base URL of the jTracks backend API.
# Used by src/lib/api-client.ts via import.meta.env.VITE_API_URL.
VITE_API_URL=http://localhost:8000

# Set to "false" to disable the MSW mock API layer even in dev
# (e.g. once a real backend is running locally). Defaults to enabled
# in dev mode, disabled in production builds.
VITE_ENABLE_MOCKS=true
